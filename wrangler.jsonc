{
  "name": "utebo-motor-selection",
  "main": "./worker.js",
  "compatibility_date": "2026-08-07",
  "keep_vars": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utebo-motor-db",
      "database_id": "5112057d-fdd1-48fd-95f9-69076daba787"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "utebo-motor-images"
    }
  ],

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
  "/api/*",
  "/media/*",
  "/admin/api/*",
  "/vehiculo/*",
  "/sitemap.xml"
]
  }
}
